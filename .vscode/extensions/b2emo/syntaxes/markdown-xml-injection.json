{
  "scopeName": "markdown.xml.injection",
  "injectionSelector": "L:meta.embedded.inline.markdown, L:text.html.markdown",
  "patterns": [
    {
      "name": "meta.tag.custom.xml",
      "begin": "(<)([a-zA-Z][\\w-]*)(?=\\s|>|/>)",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.tag.begin.xml" },
        "2": { "name": "entity.name.tag.custom.xml" }
      },
      "end": "(/>)|(?:(>))",
      "endCaptures": {
        "1": { "name": "punctuation.definition.tag.end.xml" },
        "2": { "name": "punctuation.definition.tag.end.xml" }
      },
      "patterns": [
        {
          "name": "entity.other.attribute-name.xml",
          "match": "\\b([a-zA-Z][\\w-]*)(?=\\s*=)"
        },
        {
          "name": "string.quoted.double.xml",
          "begin": "\"",
          "end": "\""
        },
        {
          "name": "string.quoted.single.xml",
          "begin": "'",
          "end": "'"
        }
      ]
    },
    {
      "name": "meta.tag.custom.end.xml",
      "match": "(</)([a-zA-Z][\\w-]*)(>)",
      "captures": {
        "1": { "name": "punctuation.definition.tag.begin.xml" },
        "2": { "name": "entity.name.tag.custom.xml" },
        "3": { "name": "punctuation.definition.tag.end.xml" }
      }
    }
  ]
}
